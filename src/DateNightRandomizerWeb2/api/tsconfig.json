{
  "compilerOptions": {
    "target": "es2016",                                
    "module": "CommonJS",                                
    "moduleResolution": "node",                    
    "esModuleInterop": true,                     
    "forceConsistentCasingInFileNames": true,   
    "strict": true,                            
    "skipLibCheck": true,
    "lib": [
        "ES2020"
    ],
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "types": ["node"]
  }
}